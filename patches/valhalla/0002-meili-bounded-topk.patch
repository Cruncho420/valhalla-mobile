diff --git a/valhalla/meili/config.h b/valhalla/meili/config.h
index d1c6cfe..1965dd3 100644
--- a/valhalla/meili/config.h
+++ b/valhalla/meili/config.h
@@ -66,10 +66,26 @@ struct Config {
     void Read(const boost::property_tree::ptree& params);
   };
 
+  // Bounds on the top-k (alternates) search. The search finds paths cheapest-first and skips
+  // a path whose edges duplicate one already found; on dense road networks it can skip
+  // thousands of near-identical state sequences before the next distinct path, each one
+  // enlarging the search graph (time and memory grow with the square of the skips).
+  struct TopK {
+    // stop looking for alternates once the next path costs more than the best path plus this;
+    // negative (the default) never stops early
+    float cost_band = -1.f;
+    // refuse the request (error 447) when the search takes more than this many rounds; 0 (default)
+    // = unbounded
+    int max_iterations = 0;
+
+    void Read(const boost::property_tree::ptree& params);
+  };
+
   CandidateSearch candidate_search{};
   TransitionCost transition_cost{};
   EmissionCost emission_cost{};
   Routing routing{};
+  TopK topk{};
 };
 
